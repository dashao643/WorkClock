/********************* QLabel *********************/
/* 深底白字 */
/* QLabel {
  font-size: 14px;
  color: #BDC8E2;
  border-radius: 10px;
  background-color: #2E3648;
} */

/* 透明底黑字 */
QLabel {
  font-size: 14px;
  color: #333;
  border-radius: 10px;
  background-color: transparent;
}

QLabel#label_today {
  font-size: 14px;
  color: #2556c8;
  border-radius: 5px;
  background-color: #93c0e4;
}

QLabel#label_clock[action="stop"] {
  font-size: 48px;
  font-weight: bold;
  color: #2C3E50;
}
QLabel#label_clock[action="start"] {
  font-size: 48px;
  font-weight: bold;
  color: #27ae60;
}

QLabel#label_date {
  font-size: 24px;
  color: #333;
  border-radius: 5px;
  background-color: transparent;
}

TimeDialog QLabel#label {
  font-size: 10px;
  color: #333;
  border-radius: 1px;
  background-color: #bccee2;
}

/********************* QProgressBar *********************/
QProgressBar {
  background-color: #f0f1f3;
  border: 1px solid #d0d5dd;
  text-align: center;
  color: #2c3e50;
}

QProgressBar::chunk {
  background-color: #4a9eff;
}

/********************* QMenu *********************/
/* QMenu {
  color: #2c3e50;
  border: 1px solid #3b68e6;
  border-radius: 6px;
} */
QMenu {
  background-color: #ffffff;
  color: #2c3e50;
  border: 1px solid #3b68e6;
  border-radius: 6px;
  padding: 4px;
}

QMenu::item {
  padding: 6px 20px;
  border-radius: 4px;
}

QMenu::item:selected {
  background-color: #e8f0fe;
  color: #3b68e6;
}

QMenu::separator {
  height: 1px;
  background-color: #e0e0e0;
  margin: 4px 8px;
}
QMenu:disabled {
  background-color: #CCC;
  color: #7878a4;
}

/********************* QLabel *********************/
/* 深底白字 */
/* QLabel {
  font-size: 14px;
  color: #BDC8E2;
  border-radius: 10px;
  background-color: #2E3648;
} */

/* 透明底黑字 */
QLabel {
  font-size: 14px;
  color: #333;
  border-radius: 10px;
  background-color: transparent;
}

QLabel#label_today {
  font-size: 14px;
  color: #2556c8;
  border-radius: 5px;
  background-color: #e9f3fb;
}

QLabel#label_clock[action="stop"] {
  font-size: 48px;
  font-weight: bold;
  color: #2C3E50;
}
QLabel#label_clock[action="start"] {
  font-size: 48px;
  font-weight: bold;
  color: #27ae60;
}

QLabel#label_date {
  font-size: 24px;
  color: #333;
  border-radius: 5px;
  background-color: transparent;
}

TimeDialog QLabel#label {
  font-size: 10px;
  color: #333;
  border-radius: 1px;
  background-color: #e9f3fb;
}

/********************* QProgressBar *********************/
QProgressBar {
  background-color: #f0f1f3;
  border: 1px solid #d0d5dd;
  text-align: center;
  color: #2c3e50;
}

QProgressBar::chunk {
  background-color: #4a9eff;
}

/********************* QMenu *********************/
QMenu {
  background-color: #ffffff;
  border: 1px solid #d0d5dd;
  border-radius: 6px;
  padding: 4px;
}
QMenu::item {
  padding: 5px 28px 5px 10px;
  border-radius: 4px;
}
QMenu::item:selected {
  background-color: #D6D6D6;
}
QMenu::item:disabled {
  color: #999;
}

/********************* QTabWidget / QTabBar *********************/
QTabWidget::pane {
  background-color: #ffffff;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
}

QTabBar::tab {
  background-color: #F8F8F8;
  color: #333;
  border: 1px solid #cccccc;
  border-bottom: none;
  padding: 4px 10px;
  border-radius: 1px;
}

QTabBar::tab:hover {
  background-color: #d6d6d6;
  color: #2c3e50;
}

QTabBar::tab:selected {
  background-color: #ffffff;
  color: #333333;
  border-top: 2px solid #4a9eff;
  border-bottom: 1px solid #ffffff;
}

QTabBar::scroller {
  width: 30px;
}

QTabBar QToolButton {
  background-color: #e5e5e5;
  color: #333;
  border: 1px solid #cccccc;
  border-radius: 3px;
  padding: 2px;
}

QTabBar QToolButton:hover {
  background-color: #d6d6d6;
  color: #2c3e50;
}

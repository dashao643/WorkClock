  border-radius: 2px;
}

QSlider::sub-page:vertical {
  background: #98D0F8;
  border-radius: 2px;
}

QSlider::add-page:vertical {
  background: transparent;
}

QSlider::handle:vertical {
  width: 16px;
  height: 16px;
  background: #89C4F4;
  border: 1px solid #6AAFE8;
